rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funções auxiliares de autenticação
    function estaAutenticado() {
      return request.auth != null;
    }

    // Regras genéricas para coleções do AgroMoz
    match /users/{userId} {
      allow read, write: if true;
    }

    match /carteiras/{userId} {
      // Utilizador só pode LER o próprio saldo, nunca alterar diretamente
      allow read: if request.auth != null && request.auth.uid == userId;

      // Nenhuma escrita é permitida do lado do cliente.
      // Todas as alterações de saldo passam obrigatoriamente pelas
      // Cloud Functions (Admin SDK), que ignoram estas regras.
      allow write: if false;
    }

    match /carteira_plataforma/{docId} {
      // Apenas utilizadores autenticados podem consultar a contabilidade/carteira da plataforma (ou restrito a admins)
      allow read: if request.auth != null;

      // Nenhuma escrita é permitida do lado do cliente.
      // Atualizações de comissões e saldo em custódia são geridas exclusivamente pelo backend (Admin SDK)
      allow write: if false;
    }

    match /transacoes_carteira/{transacaoId} {
      // Utilizador só vê o próprio histórico de transações
      allow read: if request.auth != null &&
        resource.data.userId == request.auth.uid;

      // Histórico só é criado pelo backend (Cloud Functions)
      allow write: if false;
    }

    match /levantamentos/{levantamentoId} {
      // Utilizador só vê os próprios pedidos de levantamento
      allow read: if request.auth != null &&
        resource.data.userId == request.auth.uid;

      // Criação e atualização só pelo backend (via solicitarLevantamento/webhooks)
      allow write: if false;
    }

    match /products/{productId} {
      allow read, write: if true;
    }

    match /machambas/{machambaId} {
      allow read, write: if true;
    }

    match /notifications/{notifId} {
      allow read, write: if true;
    }

    match /messages/{messageId} {
      allow read, write: if true;
    }

    match /conversas/{conversaId} {
      allow read, write: if true;

      match /mensagens/{mensagemId} {
        allow read, write: if true;
      }
    }

    match /crash_reports/{reportId} {
      allow read, write: if true;
    }

    match /orders/{orderId} {
      allow read, write: if true;

      match /propostas/{propostaId} {
        allow read, write: if true;
      }
    }

    // Regras para Transações com Custódia e Propostas de Transporte
    match /transacoes/{transacaoId} {
      allow read: if true;
      allow create: if true;
      allow update: if true; // Permite atualizações gerais da applet

      match /propostas/{propostaId} {
        // Comprador, vendedor e transportadores autenticados podem ver propostas
        allow read: if true;

        // Só um transportador autenticado pode criar proposta com seu próprio ID
        allow create: if true;

        // Comprador pode aceitar/rejeitar propostas, e transportador pode atualizar a sua própria
        allow update: if true;

        allow delete: if false;
      }
    }

    // Regra fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

