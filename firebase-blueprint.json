{
  "entities": {
    "users": {
      "fields": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "isVerifiedFarmer": { "type": "boolean" },
        "verificationStatus": { "type": "string" }
      }
    },
    "products": {
      "fields": {
        "id": { "type": "string" },
        "farmerId": { "type": "string" },
        "farmerName": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "pricePerUnit": { "type": "number" },
        "availableQuantity": { "type": "number" },
        "unit": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "orders": {
      "fields": {
        "id": { "type": "string" },
        "buyerId": { "type": "string" },
        "farmerId": { "type": "string" },
        "productId": { "type": "string" },
        "totalAmount": { "type": "number" },
        "paymentStatus": { "type": "string" },
        "deliveryStatus": { "type": "string" }
      }
    },
    "machambas": {
      "fields": {
        "id": { "type": "string" },
        "farmerId": { "type": "string" },
        "name": { "type": "string" },
        "province": { "type": "string" }
      }
    },
    "messages": {
      "fields": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "receiverId": { "type": "string" },
        "content": { "type": "string text" }
      }
    },
    "notifications": {
      "fields": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string text" }
      }
    },
    "crash_reports": {
      "fields": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "severity": { "type": "string" },
        "context": { "type": "string" },
        "errorMessage": { "type": "string text" },
        "userId": { "type": "string" }
      }
    },
    "propostas": {
      "fields": {
        "id": { "type": "string" },
        "transacaoId": { "type": "string" },
        "transportadorId": { "type": "string" },
        "valorProposto": { "type": "number" },
        "mensagem": { "type": "string" },
        "estado": { "type": "string" },
        "criadoEm": { "type": "string" }
      }
    },
    "carteiras": {
      "fields": {
        "saldoDisponivel": { "type": "number" },
        "saldoRetido": { "type": "number" },
        "moeda": { "type": "string" },
        "atualizadoEm": { "type": "string" }
      }
    },
    "transacoes_carteira": {
      "fields": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "tipo": { "type": "string" },
        "valor": { "type": "number" },
        "transacaoEncomendaId": { "type": "string" },
        "referenciaExterna": { "type": "string" },
        "estado": { "type": "string" },
        "criadoEm": { "type": "string" }
      }
    },
    "carteira_plataforma": {
      "fields": {
        "saldoTotalEmCustodia": { "type": "number" },
        "saldoComissoes": { "type": "number" },
        "saldoOperacional": { "type": "number" },
        "taxaComissaoPadrao": { "type": "number" },
        "atualizadoEm": { "type": "string" }
      }
    },
    "conversas": {
      "fields": {
        "id": { "type": "string" },
        "participantes": { "type": "array" },
        "compradorId": { "type": "string" },
        "vendedorId": { "type": "string" },
        "produtoId": { "type": "string" },
        "produtoNome": { "type": "string" },
        "ultimaMensagem": { "type": "string" },
        "ultimaMensagemEm": { "type": "string" }
      }
    },
    "mensagens_conversa": {
      "fields": {
        "id": { "type": "string" },
        "remetenteId": { "type": "string" },
        "texto": { "type": "string" },
        "lida": { "type": "boolean" },
        "criadoEm": { "type": "string" }
      }
    },
    "levantamentos": {
      "fields": {
        "userId": { "type": "string" },
        "valor": { "type": "number" },
        "numeroTelefone": { "type": "string" },
        "operadora": { "type": "string" },
        "estado": { "type": "string" },
        "motivoFalha": { "type": "string" },
        "criadoEm": { "type": "string" },
        "concluidoEm": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/carteiras/{userId}": {
      "schema": "carteiras",
      "description": "Carteiras digitais de utilizadores no AgroMoz (saldo disponível e retido em custódia)"
    },
    "/carteira_plataforma/{docId}": {
      "schema": "carteira_plataforma",
      "description": "Carteira central e contabilidade de custódia e comissões da plataforma AgroMoz"
    },
    "/transacoes_carteira/{transacaoId}": {
      "schema": "transacoes_carteira",
      "description": "Registos de transações da carteira (depósitos, levantamentos, retenções, liberações)"
    },
    "/levantamentos/{levantamentoId}": {
      "schema": "levantamentos",
      "description": "Pedidos de levantamento B2C processados para M-Pesa / e-Mola"
    },
    "/orders/{orderId}": {
      "schema": "orders",
      "description": "Encomendas e transações agrícolas do mercado AgroMoz"
    },
    "/orders/{orderId}/propostas/{propostaId}": {
      "schema": "propostas",
      "description": "Propostas de frete/transporte submetidas por motoristas"
    },
    "/transacoes/{transacaoId}": {
      "schema": "orders",
      "description": "Coleção espelho para transações com custódia de pagamento"
    },
    "/transacoes/{transacaoId}/propostas/{propostaId}": {
      "schema": "propostas",
      "description": "Propostas de transporte para a transação"
    },
    "/conversas/{conversaId}": {
      "schema": "conversas",
      "description": "Conversas ativas entre compradores e vendedores iniciadas a partir de produtos"
    },
    "/conversas/{conversaId}/mensagens/{mensagemId}": {
      "schema": "mensagens_conversa",
      "description": "Mensagens trocadas dentro de uma conversa"
    }
  }
}
